# Скопируйте в .env (docker-compose.yml читает его автоматически)

# Домен, на котором будет доступно приложение. Для локального теста без TLS: localhost
DOMAIN=domo.example.com
# Второй домен (например, зеркало на другом TLD). Для локального теста — тоже localhost.
# Если не задан, используется значение DOMAIN.
DOMAIN2=domo.example.org
# Email для уведомлений Let's Encrypt (Caddy)
ACME_EMAIL=admin@example.com

# Пароль администратора (8-72 символа). Обязателен.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Время жизни сессии в часах
SESSION_TTL_HOURS=168

# За Caddy (HTTPS) всегда true; для локального теста по http ставьте false
COOKIE_SECURE=true
TRUST_PROXY=true

# Хост-порты Caddy (для локальных тестов можно переопределить)
HTTP_PORT=80
HTTPS_PORT=443

# S3-хранилище файлов модулей (MinIO-контейнер): фото дневника лежат в нём,
# переживают падение/пересоздание приложения. Пароль — минимум 8 символов.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
S3_BUCKET=domo
S3_REGION=us-east-1
# Порт консоли MinIO на localhost (http://localhost:9001) — доступ только с хоста
# MINIO_CONSOLE_PORT=9001

# Доступы к API reg.ru для скрипта update-dns.ps1 (обновление A-записей
# при смене домашнего IP). Логин — email аккаунта, пароль — «пароль для API»
# из Настроек API reg.ru. Текущий IP должен быть в «Диапазонах IP-адресов».
REGRU_LOGIN=
REGRU_API_PASSWORD=
