# Скопируйте в .env и настройте под себя
PORT=3000
# SQLite-файл; ":memory:" для тестов/одноразовых запусков
DB_PATH=./data/perepelkin-home.db
# Время жизни сессии в часах
SESSION_TTL_HOURS=168
# true в продакшене (за HTTPS-терминатором Caddy)
COOKIE_SECURE=false
TRUST_PROXY=false
# Папка собранного SPA (apps/web/dist); пусто — не раздавать статику
WEB_DIST=../../apps/web/dist
# Каталог с модулями (подкаталог на модуль, manifest.json внутри); пусто — без простых модулей
MODULES_DIR=../../modules
# Каталог файлов модулей (фото дневника и т.п.); по умолчанию — подкаталог files рядом с БД
# FILES_DIR=./data/files
# Максимальный размер одного загружаемого файла, МБ (по умолчанию 8)
MAX_FILE_SIZE_MB=8
# S3-хранилище файлов вместо локального диска (например MinIO). Пусто — локальный диск.
# S3_ENDPOINT=minio:9000
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=domo
# S3_USE_SSL=false
# S3_REGION=us-east-1

# Умный дом (Home Assistant). Адрес и Long-Lived Access Token из профиля HA.
# Пусто — модуль «Умный дом» доступен, но не подключён.
# HA_URL=http://192.168.0.10:8123
# HA_TOKEN=

# Для npm run seed
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
