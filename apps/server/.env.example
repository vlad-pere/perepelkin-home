# Скопируйте в .env и настройте под себя
PORT=3000
# SQLite-файл; ":memory:" для тестов/одноразовых запусков
DB_PATH=./data/perepelkin-home.db
# Время жизни сессии в часах
SESSION_TTL_HOURS=168
# true в продакшене (за HTTPS-терминатором Caddy)
COOKIE_SECURE=false
TRUST_PROXY=false
# Папка собранного SPA (apps/web/dist); пусто — не раздавать статику
WEB_DIST=../../apps/web/dist
# Каталог с модулями (подкаталог на модуль, manifest.json внутри); пусто — без простых модулей
MODULES_DIR=../../modules

# Для npm run seed
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
