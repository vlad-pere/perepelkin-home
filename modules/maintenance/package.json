{
  "name": "@perepelkin-home/module-maintenance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-css.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7",
    "@types/react": "^19",
    "better-sqlite3": "^13",
    "typescript": "^5"
  }
}
